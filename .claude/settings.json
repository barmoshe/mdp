{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/preview-plan.mjs\" --hook --open || true",
            "timeout": 30,
            "statusMessage": "Rendering the plan as an MDP preview…"
          }
        ]
      }
    ]
  }
}
